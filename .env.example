# Copy to .env.local (gitignored) and tweak to exercise long-recording paths
# quickly in dev/test. These overrides are honored ONLY when the app is NOT
# packaged — production installers always use the hard-coded defaults
# regardless of what is set here.

# --- Renderer (Vite — must be VITE_ prefixed) ---

# Auto-split interval. How long a recording runs before chunks are rolled into
# a session file and the chunk index resets. Default: 17700 (4h55m).
# Set to 30 to trigger auto-split every 30 seconds for race-condition testing.
# VITE_SUISSE_MAX_DURATION_SECONDS=30

# MediaRecorder timeslice — how often ondataavailable fires with a chunk.
# Default: 3000 (3s). Lower values produce more chunks per minute, useful
# for stressing the chunk-save pipeline.
# VITE_SUISSE_MEDIA_RECORDER_TIMESLICE_MS=500

# --- Main process (plain env vars) ---

# FFmpeg operation timeout. Default: 300000 (5min). Lower during test to
# fail-fast on stuck ffmpeg invocations.
# SUISSE_FFMPEG_TIMEOUT_MS=60000
