<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<!-- App uses only Apple-provided standard encryption (HTTPS, Keychain).
	     Declaring this skips the manual "Export Compliance" gate in TestFlight
	     so new builds are immediately visible to testers. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Suisse Notes</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
	</array>
	<!-- Microphone Permission -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Suisse Notes needs access to your microphone to record meetings and conversations for transcription.</string>
	<!-- Camera Permission (required by iOS when file picker shows "Take Video" option) -->
	<key>NSCameraUsageDescription</key>
	<string>Suisse Notes may use the camera if you choose to record a video for transcription.</string>
	<!-- Bluetooth Permission (for recording device sync and wireless audio) -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Suisse Notes uses Bluetooth to connect to your recording device for syncing meetings, and to wireless microphones for audio recording.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Suisse Notes uses Bluetooth to connect to your recording device for syncing meetings, and to wireless microphones for audio recording.</string>
	<!-- App Transport Security.
	  The old comment here claimed "allow local dev servers, require HTTPS for
	  production" but the keys did the opposite: NSAllowsArbitraryLoads disables ATS
	  GLOBALLY, in the shipped app, permitting plaintext HTTP to any host for every
	  user. The app never needs that — capacitor.config.json sets iosScheme "https",
	  so the WebView is served over https://localhost, and the API is HTTPS.

	  ATS is now enforced. Cleartext is allowed ONLY for localhost, which is what a
	  Capacitor live-reload dev server actually needs, and local networking stays on
	  for device discovery. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- Custom URL scheme for SSO callback (suissenotes://auth/callback?token=...&user=...) -->
	<!-- The backend's /api/auth/<provider>/login/callback redirects here after OAuth completes. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ch.suissenotes.mobile.sso</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>suissenotes</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
